{
  "name": "@openscout/workspace-ui",
  "version": "0.1.1",
  "description": "Scout's web application frame, logo, navigation, inputs and canvas feedback.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscout-app/studio.git",
    "directory": "ui/workspace"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./tabs.d.ts",
      "default": "./tabs.js"
    },
    "./tabs": {
      "types": "./tabs.d.ts",
      "default": "./tabs.js"
    },
    "./input": {
      "types": "./input.d.ts",
      "default": "./input.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./feedback": {
      "types": "./feedback.d.ts",
      "default": "./feedback.js"
    },
    "./assets": {
      "types": "./assets.d.ts",
      "default": "./assets.js"
    },
    "./logo": "./logo.js",
    "./frame": "./frame.js",
    "./side-navigation": "./side-navigation.js",
    "./tabs.css": "./tabs.css",
    "./frame.css": "./frame.css",
    "./feedback.css": "./feedback.css",
    "./input.css": "./input.css",
    "./tokens.css": "./tokens.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "hudsonkit": "^0.3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "hudsonkit": {
      "optional": true
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "pack-static.mjs",
    "*.css",
    "LICENSE",
    "README.md"
  ]
}

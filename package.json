{
  "name": "@openscout/studio",
  "version": "0.2.0",
  "description": "What your agents make, on Scout's canvas. Pin a note on a screen and Scout takes it to the session that made it. Prebuilt HTML served on loopback and backed by the Scout CLI.",
  "license": "Apache-2.0",
  "homepage": "https://openscout.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscout-app/studio.git"
  },
  "bugs": "https://github.com/openscout-app/studio/issues",
  "type": "module",
  "bin": {
    "scout-studio": "bin/scout-studio.mjs"
  },
  "files": [
    "bin",
    "server/*.mjs",
    "!server/*.test.mjs",
    "dist",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node bin/scout-studio.mjs",
    "test": "node --test server/*.test.mjs"
  },
  "dependencies": {
    "@openscout/scout": "^0.5.4",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^4.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "scout-app": "github:openscout-app/scout-app#feba9e6",
    "vite": "^7.0.0"
  }
}

{
  "name": "@openscout/studio",
  "version": "0.1.0",
  "description": "What your agents make, on Scout's canvas. Pin a note on a screen and Scout takes it to the session that made it.",
  "license": "Apache-2.0",
  "homepage": "https://openscout.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openscout-app/studio.git"
  },
  "bugs": "https://github.com/openscout-app/studio/issues",
  "type": "module",
  "bin": {
    "scout-studio": "bin/scout-studio.mjs"
  },
  "files": [
    "bin",
    "server/*.mjs",
    "!server/*.test.mjs",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node bin/scout-studio.mjs",
    "test": "node --test server/*.test.mjs",
    "prepare": "vite build"
  },
  "dependencies": {
    "@openscout/scout": "^0.5.3",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
